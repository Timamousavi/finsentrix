# Security settings
audit=true
audit-level=high
fund=false
save-exact=true
strict-ssl=true
registry=https://registry.npmjs.org/

# Prevent scripts from running during package installation
ignore-scripts=false

# Prevent installation of packages with known vulnerabilities
engine-strict=true

# Use HTTPS for all requests
https-proxy=
proxy=

# Cache settings
cache-min=9999999
prefer-offline=true 